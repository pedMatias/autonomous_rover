# LD06/LD19-format decoder; validated against a live D500/STL-19P stream on CP2102.
# The onboard QinHeng audio-board serial endpoint returned no data in that test.
# Confirm the by-id path, direction and limits on the target rover before enabling.
LIDAR_PROTOCOL=ld06
LIDAR_DEVICE=/dev/serial/by-id/usb-Silicon_Labs_CP2102_USB_to_UART_Bridge_Controller_0001-if00-port0
LIDAR_DIRECTION=clockwise
LIDAR_RANGE_MIN=0.05
LIDAR_RANGE_MAX=12.0
